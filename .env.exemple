# Les variables du relais de courriel, à poser dans Dokploy — JAMAIS dans le dépôt.
#
# Ce fichier ne porte que des noms et des formes. Il est versionné pour qu'on sache quoi
# poser ; `.env`, lui, est ignoré par git et ne doit jamais cesser de l'être.
#
# CE QUI DÉCIDE DU MONTAGE : le DNS.
#
#   schoulbus.lu  v=spf1 include:mx.ovh.com -all    ← rejette tout ce qui n'est pas OVH
#   bas.lu        v=spf1 include:mx.ovh.com ~all    ← tolère, ce qui n'est pas pareil
#
# On remet donc au SMTP authentifié d'OVH, jamais en direct depuis le conteneur. Ne pas
# « corriger » un problème de remise en élargissant le SPF : cela ouvrirait le domaine à
# l'usurpation pour la commodité d'un formulaire.

SMTP_HOTE=ssl0.ovh.net
SMTP_PORT=587
SMTP_TLS=true

# La boîte qui s'AUTHENTIFIE. C'est elle qui a un mot de passe.
SMTP_UTILISATEUR=une-boite@schoulbus.lu
SMTP_MOTDEPASSE=

# L'adresse qui EXPÉDIE : un alias @bas.lu de la boîte ci-dessus, autorisé côté OVH.
# Différente du destinataire, à dessein.
SMTP_EXPEDITEUR=formulaire@bas.lu

# Où arrivent les messages.
COURRIEL_DESTINATAIRE=admin@schoulbus.lu
